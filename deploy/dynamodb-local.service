[Unit]
Description=DynamoDB Local for the voting app
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ec2-user
Group=ec2-user
WorkingDirectory=/home/ec2-user/tee-time-monolith/db
ExecStart=/usr/bin/java --enable-native-access=ALL-UNNAMED -jar DynamoDBLocal.jar -sharedDb
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target